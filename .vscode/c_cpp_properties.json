{
    "configurations": [
        {
            "name": "AVR",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "F_CPU=16000000UL"
            ],
            "compilerPath": "/usr/bin/avr-gcc",
            "compilerArgs": [
                "-mmcu=atmega328p"
            ],
            "cStandard": "gnu11",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ],
    "version": 4
}
